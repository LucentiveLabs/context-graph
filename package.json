{
  "name": "@lucentive-labs/context-graph",
  "version": "0.3.0",
  "description": "Experimental typed context graph, projection CLI, and local read-only MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "context-graph": "bin/context-graph.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./workspace": "./src/workspace.mjs",
    "./team": "./src/core/team.mjs",
    "./core/*": "./src/core/*.mjs",
    "./schemas/*": "./schemas/*",
    "./manifest": "./core-manifest.json"
  },
  "files": [
    "src",
    "bin",
    "schemas",
    "skills",
    "examples",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "core-manifest.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check:core && npm run check:pack",
    "check:core": "node scripts/core-manifest.mjs --check",
    "update:core": "node scripts/core-manifest.mjs --write",
    "check:install": "node scripts/check-install.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucentiveLabs/context-graph.git"
  },
  "homepage": "https://github.com/LucentiveLabs/context-graph#readme",
  "bugs": {
    "url": "https://github.com/LucentiveLabs/context-graph/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ajv": "^8.20.0",
    "zod": "^4.6.5"
  }
}
